{
  "name": "space-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:qa": "cross-env VITE_QA=1 vite build --outDir dist-qa",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:compress": "node tools/assets/compress.mjs",
    "qa:schema": "node tools/qa/schema-check.mjs",
    "qa:capture": "node tools/qa/capture.mjs",
    "qa:journey": "node tools/qa/journey.mjs journey",
    "qa:secrets": "node tools/qa/secrets.mjs",
    "qa:admin": "npm run build:qa && node tools/qa/admin-roundtrip.mjs dist-qa",
    "qa:perf": "node tools/qa/perf.mjs --vsync"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.5",
    "@fontsource/michroma": "^5.2.5",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "gsap": "^3.14.2",
    "postprocessing": "^6.37.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "draco3dgltf": "^1.5.9",
    "playwright-core": "^1.56.0",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}

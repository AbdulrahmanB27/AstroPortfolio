{
  "name": "astro-portfolio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Abdulrahman Bahjat \u2014 interactive space portfolio (home planet, rocket cockpit, solar-system project navigation).",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:resume": "node scripts/build-resume.mjs",
    "capture": "node scripts/capture-states.mjs",
    "ui:audit": "node scripts/ui-audit.mjs",
    "pages:check": "node scripts/pages-check.mjs",
    "pages:check:root": "node scripts/pages-check.mjs --root",
    "publish:site": "node scripts/publish-site.mjs",
    "perf:check": "node scripts/perf-check.mjs",
    "ui:verify": "node scripts/ui-verify.mjs",
    "media:optimise": "node scripts/optimise-media.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
